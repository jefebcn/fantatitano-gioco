{
  "name": "fantatitano-gioco",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Fantatitano — La Partita: gioco di calcio 3D nel browser (prototipo)",
  "scripts": {
    "build": "esbuild src/game.js --bundle --minify --format=iife --outfile=public/app.js && node scripts/pubblica.mjs",
    "dev": "node scripts/pubblica.mjs && esbuild src/game.js --bundle --format=iife --outfile=public/app.js --servedir=public --watch",
    "modello": "node scripts/calciatore.mjs 0.36 && python3 scripts/maschera-divisa.py 512 && node scripts/modello-js.mjs",
    "prova": "node scripts/prova-carriera.mjs && node scripts/prova-fisica.mjs",
    "controlla": "node scripts/controlla-commenti.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/functions": "^4.0.0",
    "esbuild": "^0.25.0",
    "meshoptimizer": "^0.22.0",
    "three": "0.187.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  }
}
